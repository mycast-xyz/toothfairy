{
	"server": {
		"port": 8080,
		"host": "localhost",
		"protocol": "ws"
	},
	"channels": {
		"camPrint": "cam/print"
	},
	"clients": {
		"maxConnections": 100,
		"timeout": {
			"connection": 10000,
			"message": 5000
		}
	},
	"reconnect": {
		"maxAttempts": 5,
		"interval": 3000
	},
	"logging": {
		"level": "debug",
		"console": true,
		"file": "logs/socket-server-dev.log"
	},
	"security": {
		"cors": {
			"origin": ["http://localhost:5173", "http://localhost:3000"],
			"credentials": true
		}
	},
	"data": {
		"simulation": {
			"enabled": true,
			"interval": 2000
		}
	}
}
